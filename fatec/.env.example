# Configurações do Banco de Dados PostgreSQL (Neon)
# Copie este arquivo para .env e preencha com as suas credenciais reais.
# NUNCA envie o arquivo .env preenchido para o GitHub!

DB_URL=jdbc:postgresql://seu-cluster-neon.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=seu_usuario_neon
DB_PASSWORD=sua_senha_neon
